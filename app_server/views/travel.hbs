{{!-- Minimal HBS view that renders trips from JSON --}}
<div id="body">
  <div id="content" class="content">
    <h1>{{title}}</h1>

    {{#each trips}}
      <section class="trip">
        <h2>{{this.name}}</h2>
        <div style="margin: 0 0 1rem 0;">
          <img src="{{this.image}}" alt="{{this.name}}" style="max-width:100%;height:auto;">
        </div>
        <p>{{this.description}}</p>
        <hr/>
      </section>
    {{/each}}

  </div>
</div>
